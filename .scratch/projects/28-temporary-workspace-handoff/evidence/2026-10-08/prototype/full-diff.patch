+
+/// Build a `StalePublishError` carrying the observed working-copy commit id, the dirty flag and a
+/// machine-readable reason (`commit-moved`, `dirty-working-copy`, `stale-working-copy`,
+/// `op-heads-moved`).
+pub(crate) fn stale_publish_err(
+    py: Python<'_>,
+    observed: &str,
+    dirty: bool,
+    reason: &str,
+) -> PyErr {
+    let err = StalePublishError::new_err(format!(
+        "publish_if rejected ({reason}): observed working-copy commit {observed}, dirty={dirty}"
+    ));
+    let value = err.value(py);
+    let _ = value.setattr("observed", observed);
+    let _ = value.setattr("dirty", dirty);
+    let _ = value.setattr("reason", reason);
+    err
+}
