# {{ project_name }} devenv.
#
# Testee runs the checks below on a fixed commit. Run `testee verify` for the gate
# and `testee verify <id>` for one check. Run `testee status` to read the verdict.
# The module comes from the locked `testee` input in `devenv.yaml`.
{ pkgs, config, ... }:

{
  languages.python = {
    enable = true;
    venv.enable = true;
    uv.enable = true;
  };

  # Testee checks a clean worktree. Build its venv from the lock file first.
  testee.prepare = [ [ "uv" "sync" "--locked" ] ];

  testee.checks = {
    ruff = {
      argv = [ "uv" "run" "--no-sync" "ruff" "check" "src" "tests" "--output-format" "json" ];
      profiles = [ "quick" "full" ];
      structured = { parser = "ruff-json"; file = "ruff.stdout.log"; };
    };
    ruff-format = {
      argv = [ "uv" "run" "--no-sync" "ruff" "format" "--check" "src" "tests" ];
      profiles = [ "quick" "full" ];
    };
    ty = {
      argv = [
        "uv" "run" "--no-sync" "ty" "check" "src" "tests"
        "--python" "${config.devenv.state}/venv/bin/python3"
      ];
      profiles = [ "full" ];
    };
    pytest = {
      argv = [
        "${pkgs.bash}/bin/bash" "-c"
        ''uv run --no-sync pytest -q tests --junitxml="$TESTEE_RUN_DIR/pytest.junit.xml"''
      ];
      profiles = [ "full" ];
      structured = { parser = "junit-xml"; file = "pytest.junit.xml"; };
    };
  };
}
