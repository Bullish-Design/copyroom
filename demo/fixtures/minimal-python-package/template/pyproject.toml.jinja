[project]
name = "{{ project_name }}"
version = "{{ _version }}"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.13"
license = { text = "MIT" }

authors = [
  { name = "{{ author_name }}", email = "{{ author_email }}" },
]

dependencies = []

[dependency-groups]
# Testee 0.5 does not ship pytest, ruff, or ty. Declare each tool here.
# The checks in devenv.nix run them. The testee entry gives the Python API;
# the CLI wrapper comes from the same pinned tag in devenv.nix.
dev = ["pytest", "ruff", "testee", "ty"]

[tool.uv.sources]
# Pin one Testee tag. Keep it equal to the tag in devenv.nix.
testee = { git = "https://github.com/Bullish-Design/testee", tag = "v0.5.0" }

[build-system]
requires = ["hatchling>=1.18"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
