[project]
name = "{{ project_name }}"
version = "{{ _version }}"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.13"
license = { text = "MIT" }

authors = [
  { name = "{{ author_name }}", email = "{{ author_email }}" },
]

dependencies = []

[dependency-groups]
# Testee 0.5 does not ship pytest, ruff, or ty. Declare each tool here.
# The checks in devenv.nix run them. Testee is not a uv dependency: the host
# profile provides the `testee` wrapper, and devenv.nix pins the Nix module.
dev = ["pytest", "ruff", "ty"]

[build-system]
requires = ["hatchling>=1.18"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
